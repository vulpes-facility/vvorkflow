{
  "name": "@vvorkflow/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "bundle": "tauri build --config src-tauri/tauri.bundle.json",
    "tauri": "tauri",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "lint": "prettier --check . && oxlint --deny-warnings && steiger src && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "check-types": "tsc -b",
    "generate:protocol": "json-schema-to-zod -i ../../crates/vvorkflow-protocol/schema/protocol.schema.json -o src/shared/api/protocol.gen.ts -n protocol && prettier --write src/shared/api/protocol.gen.ts",
    "test": "vitest run --passWithNoTests && cargo test --manifest-path src-tauri/Cargo.toml --workspace --locked",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "screens": "storybook build --quiet -o storybook-static && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dockview-react": "8.8.3",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.19.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^7.29.7",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tauri-apps/cli": "2.12.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "json-schema-to-zod": "2.8.1",
    "oxlint": "^1.90.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "steiger": "0.9.0",
    "storybook": "^10.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
