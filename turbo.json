{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_*",
        "TAURI_ENV_*"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "lint": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    }
  }
}
