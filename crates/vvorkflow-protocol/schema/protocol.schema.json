{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol",
  "type": "object",
  "properties": {
    "attach_session": {
      "description": "Attaches the connection to a session: the screen of the session comes as\na binary frame, and then each byte of its output. A second attach sends\nthe screen again.",
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ]
    },
    "changed_path": {
      "description": "A path with a git status, relative to its worktree, with `/` between the\nnames. A folder that git reports as a whole, such as an ignored or an\nuntracked folder, ends with `/`.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "untracked",
            "conflict",
            "ignored"
          ]
        }
      },
      "required": [
        "path",
        "status"
      ]
    },
    "create_project": {
      "description": "Makes a project: a new, empty folder directly in the projects root.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name of the folder: one name that each system accepts, which does\nnot start with a dot.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "create_session": {
      "description": "Starts the shell of the user in a new pseudo-terminal. The request has no\ncommand: the user types each command (core value 6).",
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "format": "uint16",
          "maximum": 500,
          "minimum": 2
        },
        "rows": {
          "type": "integer",
          "format": "uint16",
          "maximum": 200,
          "minimum": 1
        },
        "worktree": {
          "description": "The absolute path of an open worktree, where the shell starts. None\nis the projects root.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    },
    "detach_session": {
      "description": "Detaches the connection from a session; the session continues.",
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ]
    },
    "directory_entry": {
      "description": "An entry of a folder.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "folder"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ]
    },
    "done": {
      "description": "The answer of a request that has no value.",
      "type": "object"
    },
    "engine_error": {
      "description": "A refused or failed request.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The kind of an error: `notFound`, the path does not exist;\n`permissionDenied`, the path is outside the roots that the engine can\nreach; `invalidArgument`, the request is not valid, for example a relative\npath; `failedPrecondition`, the state does not let the request occur, for\nexample git is missing. The variants have no doc comments of their own,\nso that the schema keeps them as one plain enum.",
          "type": "string",
          "enum": [
            "notFound",
            "permissionDenied",
            "invalidArgument",
            "failedPrecondition"
          ]
        },
        "message": {
          "description": "A sentence for the user.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "event": {
      "description": "A message without an id, which the engine can send at any time after\n`hello`, between the answers. The engine sends the events of a session\nonly to its attached clients.",
      "oneOf": [
        {
          "description": "The shell of a session ended. No frame of that session follows.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "session.ended"
            },
            "params": {
              "description": "The end of the shell of a session.",
              "type": "object",
              "properties": {
                "exitCode": {
                  "description": "The exit code of the shell, or none when a signal ended it.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint32",
                  "minimum": 0
                },
                "session": {
                  "type": "string"
                },
                "signal": {
                  "description": "The signal that ended the shell, or none. Always none on Windows.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int32"
                }
              },
              "required": [
                "session"
              ]
            }
          },
          "required": [
            "event",
            "params"
          ]
        },
        {
          "description": "A session has a new size, from the output that follows.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "session.resized"
            },
            "params": {
              "description": "The new size of a session.",
              "type": "object",
              "properties": {
                "columns": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 500,
                  "minimum": 2
                },
                "rows": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 200,
                  "minimum": 1
                },
                "session": {
                  "type": "string"
                }
              },
              "required": [
                "session",
                "columns",
                "rows"
              ]
            }
          },
          "required": [
            "event",
            "params"
          ]
        },
        {
          "description": "The connection of the app core to the engine ended. Only the app core\nsends it, after the last frame of that connection.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "connection.closed"
            },
            "params": {
              "description": "The end of the connection of the app core to the engine.",
              "type": "object"
            }
          },
          "required": [
            "event",
            "params"
          ]
        }
      ]
    },
    "hello": {
      "description": "Starts a connection with the protocol version of the client.",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocol"
      ]
    },
    "kill_session": {
      "description": "Ends a session: the shell and its foreground job get SIGHUP, and SIGKILL\nafter 3 seconds.",
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ]
    },
    "list_directory": {
      "description": "Lists one folder of a worktree. The engine reads only this folder, so that\na large tree, such as `node_modules`, costs nothing until the user opens it.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The folder, relative to the worktree, with `/` between the names.\nAn empty path is the worktree itself.",
          "type": "string"
        },
        "worktree": {
          "description": "The absolute path of the worktree.",
          "type": "string"
        }
      },
      "required": [
        "worktree",
        "path"
      ]
    },
    "list_projects": {
      "description": "Lists the projects: the folders directly in the projects root.",
      "type": "object"
    },
    "list_sessions": {
      "description": "Lists the terminal sessions of the engine.",
      "type": "object"
    },
    "open_folder": {
      "description": "Opens a folder: a git repository, or a plain folder.\nThe engine adds the folder, and each worktree of its repository, to the\nroots that later requests can reach (core value 6).",
      "type": "object",
      "properties": {
        "path": {
          "description": "An absolute path on the machine of the engine.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ]
    },
    "project": {
      "description": "A folder directly in the projects root.",
      "type": "object",
      "properties": {
        "git": {
          "description": "True when the folder has a `.git` entry.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "The absolute path, which `folder.open` takes.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "git"
      ]
    },
    "read_status": {
      "description": "Reads the git status of a worktree.",
      "type": "object",
      "properties": {
        "worktree": {
          "description": "The absolute path of the worktree.",
          "type": "string"
        }
      },
      "required": [
        "worktree"
      ]
    },
    "repository": {
      "description": "A repository and its worktrees, or a plain folder as one worktree.",
      "type": "object",
      "properties": {
        "git": {
          "description": "False for a plain folder, which has no git status.",
          "type": "boolean"
        },
        "name": {
          "description": "The name of the folder of the main worktree.",
          "type": "string"
        },
        "worktrees": {
          "type": "array",
          "items": {
            "description": "One worktree of a repository.",
            "type": "object",
            "properties": {
              "branch": {
                "description": "The checked-out branch, without `refs/heads/`. None when the HEAD is\ndetached, or for a plain folder.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "current": {
                "description": "True for the worktree of the opened folder.",
                "type": "boolean"
              },
              "path": {
                "description": "The absolute path of the worktree.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "current"
            ]
          }
        }
      },
      "required": [
        "name",
        "git",
        "worktrees"
      ]
    },
    "request": {
      "description": "A request to the engine: its method, and its params.",
      "oneOf": [
        {
          "description": "The first request of a connection. Answers [`Welcome`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "hello"
            },
            "params": {
              "description": "Starts a connection with the protocol version of the client.",
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "protocol"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Answers each [`Project`] in the projects root.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "project.list"
            },
            "params": {
              "description": "Lists the projects: the folders directly in the projects root.",
              "type": "object"
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Makes a folder in the projects root. Answers its [`Project`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "project.create"
            },
            "params": {
              "description": "Makes a project: a new, empty folder directly in the projects root.",
              "type": "object",
              "properties": {
                "name": {
                  "description": "The name of the folder: one name that each system accepts, which does\nnot start with a dot.",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Answers a [`Repository`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "folder.open"
            },
            "params": {
              "description": "Opens a folder: a git repository, or a plain folder.\nThe engine adds the folder, and each worktree of its repository, to the\nroots that later requests can reach (core value 6).",
              "type": "object",
              "properties": {
                "path": {
                  "description": "An absolute path on the machine of the engine.",
                  "type": "string"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Answers each [`DirectoryEntry`] of the folder.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "directory.list"
            },
            "params": {
              "description": "Lists one folder of a worktree. The engine reads only this folder, so that\na large tree, such as `node_modules`, costs nothing until the user opens it.",
              "type": "object",
              "properties": {
                "path": {
                  "description": "The folder, relative to the worktree, with `/` between the names.\nAn empty path is the worktree itself.",
                  "type": "string"
                },
                "worktree": {
                  "description": "The absolute path of the worktree.",
                  "type": "string"
                }
              },
              "required": [
                "worktree",
                "path"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Answers each [`ChangedPath`] of the worktree.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "git.status"
            },
            "params": {
              "description": "Reads the git status of a worktree.",
              "type": "object",
              "properties": {
                "worktree": {
                  "description": "The absolute path of the worktree.",
                  "type": "string"
                }
              },
              "required": [
                "worktree"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Answers each [`Session`] of the engine, in the order of its start.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "session.list"
            },
            "params": {
              "description": "Lists the terminal sessions of the engine.",
              "type": "object"
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Starts the shell of the user in a new pseudo-terminal. Answers its\n[`Session`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "session.create"
            },
            "params": {
              "description": "Starts the shell of the user in a new pseudo-terminal. The request has no\ncommand: the user types each command (core value 6).",
              "type": "object",
              "properties": {
                "columns": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 500,
                  "minimum": 2
                },
                "rows": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 200,
                  "minimum": 1
                },
                "worktree": {
                  "description": "The absolute path of an open worktree, where the shell starts. None\nis the projects root.",
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "columns",
                "rows"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Sends the screen and then the output of a session to this connection.\nAnswers the [`Session`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "session.attach"
            },
            "params": {
              "description": "Attaches the connection to a session: the screen of the session comes as\na binary frame, and then each byte of its output. A second attach sends\nthe screen again.",
              "type": "object",
              "properties": {
                "session": {
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Stops the output of a session to this connection. Answers [`Done`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "session.detach"
            },
            "params": {
              "description": "Detaches the connection from a session; the session continues.",
              "type": "object",
              "properties": {
                "session": {
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Puts input bytes in the input queue of a session. Answers [`Done`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "session.write"
            },
            "params": {
              "description": "Sends input to the program of a session.",
              "type": "object",
              "properties": {
                "data": {
                  "description": "The input bytes in Base64 (RFC 4648, with padding).",
                  "type": "string"
                },
                "session": {
                  "type": "string"
                }
              },
              "required": [
                "session",
                "data"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Changes the size of a session. Answers [`Done`].",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "session.resize"
            },
            "params": {
              "description": "Changes the size of the pseudo-terminal and of the kept screen.",
              "type": "object",
              "properties": {
                "columns": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 500,
                  "minimum": 2
                },
                "rows": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 200,
                  "minimum": 1
                },
                "session": {
                  "type": "string"
                }
              },
              "required": [
                "session",
                "columns",
                "rows"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Ends a session as the close of a terminal window does. Answers\n[`Done`]; the event `session.ended` follows.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "session.kill"
            },
            "params": {
              "description": "Ends a session: the shell and its foreground job get SIGHUP, and SIGKILL\nafter 3 seconds.",
              "type": "object",
              "properties": {
                "session": {
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "description": "Stops the engine process. Answers [`Done`], then the process stops.\nIt is valid before `hello`, and its shape never changes from protocol\n3, so that each app can stop an engine of another version.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "shutdown"
            },
            "params": {
              "description": "Stops the engine process.",
              "type": "object",
              "properties": {
                "force": {
                  "description": "False, or not set: an engine with sessions refuses to stop. True: the\nengine ends each session, and then stops.",
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "required": [
            "method",
            "params"
          ]
        }
      ]
    },
    "resize_session": {
      "description": "Changes the size of the pseudo-terminal and of the kept screen.",
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "format": "uint16",
          "maximum": 500,
          "minimum": 2
        },
        "rows": {
          "type": "integer",
          "format": "uint16",
          "maximum": 200,
          "minimum": 1
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session",
        "columns",
        "rows"
      ]
    },
    "session": {
      "description": "A terminal session: a pseudo-terminal with the shell of the user in it.",
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "format": "uint16",
          "maximum": 500,
          "minimum": 2
        },
        "folder": {
          "description": "The absolute path of the folder where the shell started.",
          "type": "string"
        },
        "id": {
          "description": "16 characters, each a digit or a lowercase letter from `a` to `f`.",
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "format": "uint16",
          "maximum": 200,
          "minimum": 1
        },
        "title": {
          "description": "The last title that the program set, or the name of the shell.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "folder",
        "columns",
        "rows"
      ]
    },
    "shutdown": {
      "description": "Stops the engine process.",
      "type": "object",
      "properties": {
        "force": {
          "description": "False, or not set: an engine with sessions refuses to stop. True: the\nengine ends each session, and then stops.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "welcome": {
      "description": "The answer to [`Hello`] when the engine speaks the protocol of the client.",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "root": {
          "description": "The absolute path of the projects root.",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "root"
      ]
    },
    "write_session": {
      "description": "Sends input to the program of a session.",
      "type": "object",
      "properties": {
        "data": {
          "description": "The input bytes in Base64 (RFC 4648, with padding).",
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session",
        "data"
      ]
    }
  },
  "required": [
    "request",
    "hello",
    "welcome",
    "list_projects",
    "create_project",
    "shutdown",
    "done",
    "project",
    "open_folder",
    "repository",
    "list_directory",
    "directory_entry",
    "read_status",
    "changed_path",
    "list_sessions",
    "create_session",
    "attach_session",
    "detach_session",
    "write_session",
    "resize_session",
    "kill_session",
    "session",
    "event",
    "engine_error"
  ],
  "x-protocol-version": 3
}
